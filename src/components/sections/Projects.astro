---
import { REAL_PROJECTS } from '../../config/site';
---

<section id="proyectos" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-[var(--border-subtle)] relative">
  <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] border border-cyan-500/20 text-cyan-500 font-mono text-xs">
      <span>CASOS REALES EN PRODUCCIÓN</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight">
      Algunos trabajos recientes
    </h2>

    <p class="text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed">
      Sistemas y plataformas reales construidos a medida con arquitecturas robustas y escalables.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {REAL_PROJECTS.map((project) => (
      <div class="group relative rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-card)] hover:border-cyan-500/40 transition-all duration-300 overflow-hidden shadow-xl flex flex-col justify-between">
        
        <!-- Technical Mockup Header/Viewport -->
        <div class="relative bg-[var(--code-bg)] border-b border-[var(--border-subtle)] p-5 sm:p-6 overflow-hidden">
          {/* Blueprint corner crosshairs */}
          <div class="absolute top-2 left-2 text-[9px] font-mono text-[var(--text-muted)]">+</div>
          <div class="absolute top-2 right-2 text-[9px] font-mono text-[var(--text-muted)]">+</div>

          {/* Browser-like window header */}
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 font-mono text-xs">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-red-500/70"></span>
              <span class="w-2 h-2 rounded-full bg-yellow-500/70"></span>
              <span class="w-2 h-2 rounded-full bg-emerald-500/70"></span>
              <span class="text-slate-300 ml-2">{project.name.toLowerCase()}.app</span>
            </div>
            <span class="text-emerald-400 text-[10px] px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/40">
              {project.status}
            </span>
          </div>

          <!-- Dynamic Architectural Mockup Canvas -->
          <div class="rounded-xl bg-[#080d1a] border border-white/10 p-4 font-mono text-xs space-y-3">
            <div class="flex items-center justify-between text-slate-400 text-[11px] pb-2 border-b border-white/5">
              <span>MÓDULO: {project.code}</span>
              <span class="text-cyan-400 font-semibold">{project.category}</span>
            </div>

            <div class="p-3 rounded-lg bg-black/50 border border-white/5 space-y-1.5">
              <div class="flex items-center justify-between text-slate-200 text-xs font-semibold">
                <span>{project.tagline}</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-[10px] text-slate-400">
                {project.metrics.map((m) => (
                  <div class="flex items-center space-x-1.5">
                    <span class="w-1 h-1 rounded-full bg-cyan-400"></span>
                    <span>{m}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Project Details Body -->
        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-6">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-cyan-500 transition-colors">
                {project.name}
              </h3>
              <span class="text-xs font-mono text-[var(--text-muted)]">{project.category}</span>
            </div>

            <p class="text-[var(--text-secondary)] text-sm leading-relaxed mb-5">
              {project.description}
            </p>

            <!-- Stack Badges -->
            <div class="flex flex-wrap gap-2 pt-2">
              {project.technologies.map((tech) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)] group-hover:border-cyan-500/30 transition-colors">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-5 border-t border-[var(--border-subtle)] flex items-center justify-between">
            <span class="text-xs font-mono text-[var(--text-muted)]">
              Desarrollo integral mexxtz.dev
            </span>

            <a
              href="#contacto"
              class="inline-flex items-center space-x-1.5 text-xs font-mono font-medium text-cyan-500 hover:text-cyan-400 transition-colors"
            >
              <span>Consultar arquitectura similar</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] text-center max-w-xl mx-auto">
    <p class="text-xs font-mono text-[var(--text-secondary)]">
      * Mostramos únicamente proyectos y clientes reales. ¿Tenés un requerimiento específico con otra tecnología? Evaluamos tu caso.
    </p>
  </div>
</section>
