---
import { SITE_CONFIG } from '../../config/site';
import HeroWorkbench from '../islands/HeroWorkbench';
---

<section id="inicio" class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-20 sm:pt-20 sm:pb-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    
    <!-- Left Column: Copy & Actions -->
    <div class="lg:col-span-6 space-y-6 sm:space-y-8 text-center lg:text-left">
      <!-- Blueprint tech badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/[0.03] border border-cyan-500/20 text-cyan-300 font-mono text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>ESTUDIO TECNOLÓGICO · INGENIERÍA DIGITAL</span>
      </div>

      <!-- Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
        Convertimos tus ideas en productos digitales que generan <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-blue-500 underline decoration-cyan-400/40 decoration-4 underline-offset-8">resultados.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg text-slate-400 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
        {SITE_CONFIG.subheadline}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
        <a
          href="#contacto"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm text-slate-950 bg-gradient-to-r from-cyan-400 to-cyan-300 hover:from-cyan-300 hover:to-cyan-200 transition-all duration-200 shadow-xl shadow-cyan-950/50 hover:shadow-cyan-400/20 hover:scale-[1.02] active:scale-[0.98] text-center"
        >
          Solicitar presupuesto
        </a>

        <a
          href="#proyectos"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-mono text-xs text-slate-300 bg-white/[0.03] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 transition-all text-center flex items-center justify-center space-x-2"
        >
          <span>Ver proyectos</span>
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Micro Value Indicators -->
      <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-center lg:justify-start gap-4 sm:gap-6 text-xs text-slate-400 font-mono">
        <div class="flex items-center space-x-2">
          <div class="w-4 h-4 rounded-full bg-cyan-500/10 text-cyan-400 flex items-center justify-center">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span>Entrega rápida</span>
        </div>

        <div class="flex items-center space-x-2">
          <div class="w-4 h-4 rounded-full bg-violet-500/10 text-violet-400 flex items-center justify-center">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <span>Código limpio y escalable</span>
        </div>

        <div class="flex items-center space-x-2">
          <div class="w-4 h-4 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span>Soporte real</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Tech Workbench Composition -->
    <div class="lg:col-span-6 w-full flex justify-center">
      <HeroWorkbench client:load />
    </div>

  </div>
</section>
