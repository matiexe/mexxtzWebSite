---
import { PROCESS_STEPS } from '../../config/site';
---

<section id="proceso" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-white/5 relative">
  <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/[0.03] border border-cyan-500/20 text-cyan-400 font-mono text-xs">
      <span>METODOLOGÍA & FLUJO TÉCNICO</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Así trabajamos
    </h2>

    <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
      Un proceso transparente de 5 etapas para transformar una idea en un sistema en producción sin sorpresas ni demoras innecesarias.
    </p>
  </div>

  <!-- Connecting Visual Circuit Line Container -->
  <div class="relative">
    <!-- Desktop Connecting Horizontal Line -->
    <div class="hidden lg:block absolute top-[52px] left-[5%] right-[5%] h-[2px] bg-gradient-to-r from-cyan-500/10 via-cyan-400/40 to-cyan-500/10 z-0"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 relative z-10">
      {PROCESS_STEPS.map((step) => (
        <div class="relative group rounded-2xl p-6 border border-white/10 bg-[#080d19]/90 hover:bg-[#0c1424] hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between shadow-lg">
          <!-- Step indicator badge -->
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#060911] border border-cyan-500/30 text-cyan-400 font-mono text-base font-bold flex items-center justify-center group-hover:scale-110 group-hover:border-cyan-400 group-hover:shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all">
              {step.step}
            </div>
            <span class="text-[10px] font-mono text-slate-500">{step.code}</span>
          </div>

          <div>
            <h3 class="text-base font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
              {step.title}
            </h3>

            <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
              {step.description}
            </p>
          </div>

          <!-- Subtle bottom status -->
          <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-slate-600">
            <span>FASE 0{step.step}</span>
            <span class="text-cyan-500/80">VERIFICADO</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
