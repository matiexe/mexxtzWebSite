---
import { AI_SOLUTIONS } from '../../config/site';
---

<section id="ia" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-white/5 relative">
  <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 font-mono text-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
      <span>AUTOMATIZACIÓN & AGENTES INTELIGENTES</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      {AI_SOLUTIONS.headline}
    </h2>

    <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
      {AI_SOLUTIONS.description}
    </p>
  </div>

  <!-- Visual Workflow Diagram (Visitante -> Agente -> Calificación -> Presupuesto -> Cliente) -->
  <div class="mb-16 p-6 sm:p-8 rounded-2xl border border-white/10 bg-[#080d19]/90 backdrop-blur-md shadow-2xl relative overflow-hidden">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10 font-mono text-xs text-slate-400">
      <span class="text-violet-400 font-semibold flex items-center">
        <svg class="w-4 h-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 6v6l4 2" />
        </svg>
        PIPELINE DE CONVERSIÓN CON AGENTES IA
      </span>
      <span class="text-slate-500 hidden sm:inline">EJECUCIÓN CONTINUA 24/7</span>
    </div>

    <!-- Responsive flow blocks -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-center">
      {AI_SOLUTIONS.workflow.map((item, index) => (
        <div class="relative flex flex-col items-center">
          <div class={`w-full p-4 rounded-xl border text-center transition-all ${
            item.step === 2 || item.step === 3
              ? 'bg-violet-950/30 border-violet-500/40 text-violet-200 shadow-md shadow-violet-950/50'
              : 'bg-white/[0.02] border-white/10 text-slate-300'
          }`}>
            <span class="text-[10px] font-mono text-slate-500 block mb-1">0{item.step}</span>
            <span class="text-xs sm:text-sm font-bold font-mono tracking-wide block text-white mb-1">
              {item.label}
            </span>
            <p class="text-[11px] text-slate-400 leading-tight">
              {item.desc}
            </p>
          </div>

          {/* Desktop connecting arrow to next step */}
          {index < AI_SOLUTIONS.workflow.length - 1 && (
            <div class="hidden md:flex absolute -right-3 top-1/2 -translate-y-1/2 z-20 w-6 h-6 rounded-full bg-[#0a0f1d] border border-violet-500/30 items-center justify-center text-violet-400 text-xs shadow">
              →
            </div>
          )}

          {/* Mobile connecting arrow downward */}
          {index < AI_SOLUTIONS.workflow.length - 1 && (
            <div class="flex md:hidden my-1 text-violet-400 text-xs font-mono">
              ↓
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Agent Profiles Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
    {AI_SOLUTIONS.agents.map((agent) => (
      <div class="p-6 rounded-2xl border border-white/10 bg-[#080d19]/80 hover:border-violet-500/40 hover:bg-[#0c1324] transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-violet-950/60 border border-violet-800/40 text-violet-300">
              {agent.badge}
            </span>
          </div>

          <h3 class="text-base font-bold text-white mb-2">{agent.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{agent.description}</p>
        </div>

        <div class="mt-4 pt-3 border-t border-white/5 text-[10px] font-mono text-slate-500">
          Autonomía con control humano
        </div>
      </div>
    ))}
  </div>

  <!-- Section CTA -->
  <div class="text-center">
    <a
      href="#contacto"
      class="inline-flex items-center space-x-2 px-8 py-3.5 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 transition-all shadow-xl shadow-violet-950/50 hover:scale-[1.02] active:scale-[0.98]"
    >
      <span>Quiero automatizar mi negocio</span>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>
