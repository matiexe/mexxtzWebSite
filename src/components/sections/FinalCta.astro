---
import { SITE_CONFIG } from '../../config/site';
import LeadQualificationForm from '../islands/LeadQualificationForm';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.social.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(SITE_CONFIG.social.whatsappDefaultMessage)}`;
---

<section id="contacto" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-[var(--border-subtle)] relative">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- Left column: Persuasive copy & direct contact methods -->
    <div class="lg:col-span-5 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-500 font-mono text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>HABLEMOS DE TU PROYECTO</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--text-primary)] tracking-tight leading-tight">
        ¿Tenés una idea o un problema que resolver?
      </h2>

      <p class="text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed">
        Contanos qué necesitás y evaluamos juntos la mejor solución técnica, sin rodeos y adaptada a tu presupuesto.
      </p>

      <!-- Direct Contact Badges -->
      <div class="space-y-3 pt-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center space-x-3 p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 transition-all group"
        >
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-500 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-300">Hablar por WhatsApp</div>
            <div class="text-[11px] text-[var(--text-muted)]">Atención ágil sin esperas</div>
          </div>
        </a>

        <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] text-xs font-mono text-[var(--text-secondary)] space-y-1.5">
          <div class="flex items-center space-x-2 text-[var(--text-primary)]">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Ubicación: Argentina · Operación Remota Global</span>
          </div>
          <div class="flex items-center space-x-2 text-[var(--text-primary)]">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Tiempo promedio de respuesta: Menos de 24hs</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: Interactive Lead Qualification Form Island -->
    <div class="lg:col-span-7 w-full">
      <LeadQualificationForm client:visible />
    </div>

  </div>
</section>
