# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (RECOMENDADO PARA VERCEL)
# ==========================================
# En desarrollo local el proyecto funciona sin variables (crea leads.db automáticamente).
# Para producción en Vercel, crea una base de datos gratis en https://turso.tech y agrega:
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# ==========================================
# NOTIFICACIONES INSTANTÁNEAS DE LEADS (OPCIONAL)
# ==========================================
# Webhook de Discord, Telegram o Slack para que cada lead te llegue al instante al celular:
# LEADS_WEBHOOK_URL=https://discord.com/api/webhooks/...
